{
  "compilerOptions": {
    "target": "ES2022",

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "strict": false,

    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,

    "moduleResolution": "Bundler",
    "skipLibCheck": true,

    "maxNodeModuleJsDepth": 0
  },
  "include": ["**/*.js"],
  "exclude": [
    "node_modules"
  ]
}